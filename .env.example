# Enrolment: Razorpay → Google Drive access → welcome email.
# Real values go in Vercel → Settings → Environment Variables (Production,
# marked Sensitive), never in this file or in git. See README → Enrolment.

# Razorpay → Account & Settings → API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Account & Settings → Webhooks (the secret you set there)
RAZORPAY_WEBHOOK_SECRET=

# Google Cloud service account (from its JSON key: client_email, private_key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# The course folder: the part of its URL after /folders/
DRIVE_FOLDER_ID=

# Simran's Gmail and an app password for it (Google Account → App passwords)
GMAIL_USER=learnwithpianowali@gmail.com
GMAIL_APP_PASSWORD=
# Where alerts go (defaults to GMAIL_USER)
ADMIN_EMAIL=

# Optional: the WhatsApp community invite, once it exists
WHATSAPP_GROUP_LINK=
